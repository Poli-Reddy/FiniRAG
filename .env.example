# ── Database ──
# Render supplies postgres://... ; the app rewrites it to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── LLM: primary ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM: fallback (optional) ──
# Tried when Gemini refuses a call — quota, transport error, or a reply that
# will not parse. Leave GROQ_API_KEY empty to disable the fallback entirely;
# the pipeline then runs on Gemini alone, exactly as it did before.
#
# GROQ_VISION_MODEL must accept image parts AND honour
# response_format=json_object. On the current account only qwen3.8-27b does
# both — qwen3.6-27b fails JSON validation on this workload, and the gpt-oss
# and compound models reject multimodal content outright. No document in the
# dataset has a native text layer, so this is the model that does the work.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── OCR ──
# Mistral is the primary OCR backend (layout blocks for traceable evidence).
# Google Vision remains available as OCR_PROVIDER=google_vision for legacy
# deployments; it needs a service-account JSON. On Render, mount it as a
# secret file and point GOOGLE_VISION_CREDENTIALS at the mount path — a
# repo-relative path will not resolve.
MISTRAL_API_KEY=your_mistral_api_key_here
GOOGLE_VISION_CREDENTIALS=path/to/service_account.json
OCR_PROVIDER=mistral
LLM_PROVIDER=gemini

# Extraction, answer generation and the LLM question classifier all use this
# single model. gemini-3.8-flash is the currently supported Gemini model
# (2.5-series is closed to new users; older flash ids may be quota-capped).
GEMINI_MODEL=gemini-3.8-flash

# ── Application ──
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=10
MAX_PAGES=3

# ── RAG / Embeddings ──
# gemini-embedding-2 (GA Apr 2026, retired text-embedding-004 Jan 2026).
# Default 3072 dims, MRL-truncated to EMBEDDING_DIM via output_dimensionality.
# Changing model or dim requires full re-embedding (spaces incompatible).
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_S=30
EMBEDDING_MAX_RETRIES=3
INDEX_VERSION=v1
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_LIMIT_PER_PATH=8
RETRIEVAL_RRF_K=60
QA_MAX_CONTEXT_CHUNKS=8
QA_REQUEST_TIMEOUT_S=60

# ── Retrieval tuning ──
# HNSW search breadth (recall vs latency dial; pgvector default is 40).
HNSW_EF_SEARCH=100
# Python fallback only runs on sqlite/offline; cap its row sweep.
RETRIEVAL_FALLBACK_MAX_ROWS=2000

# ── Provider resilience ──
# Retries for transient provider failures (429/5xx/timeout), per-attempt cap,
# circuit-breaker threshold/cooldown, and a hard per-call timeout.
PROVIDER_MAX_RETRIES=3
PROVIDER_BASE_DELAY_S=1.0
PROVIDER_MAX_DELAY_S=8.0
PROVIDER_TIMEOUT_S=30.0
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_S=60.0

# ── API guards ──
# Per-client request budget for the expensive endpoints, and the maximum time
# any single Postgres statement may run before it is cancelled server-side.
RATE_LIMIT_PER_MINUTE=60
DB_STATEMENT_TIMEOUT_MS=15000

# ── API access control ──
# Optional shared-secret gate for every /api/v1 route (comma-separated).
# Empty = OPEN (local dev). SET THIS BEFORE ANY PUBLIC EXPOSURE: the API
# serves full extracted financial records. Health stays public either way.
# Clients send `Authorization: Bearer <key>` or `X-API-Key: <key>`.
# Single-tenant scoping only — per-user document ownership is still open.
API_KEYS=
# Trust X-Forwarded-For for rate-limit identity. Correct behind Render's
# proxy (appends the client address); disable if the proxy chain is unknown.
TRUST_X_FORWARDED_FOR=true
# Same-origin only by default (the dashboard is served by this app).
# Comma-separated origins only for a separately hosted UI.
ALLOWED_ORIGINS=

# ── Upload decoding bounds ──
# Compressed size says nothing about decoded cost; images/pages beyond these
# pixel counts are rejected before OCR or rendering allocates further.
MAX_IMAGE_PIXELS=50000000
MAX_RENDER_PIXELS_PER_PAGE=50000000
# Retained OCR/native text per document, for verifiable indexing.
MAX_SOURCE_TEXT_CHARS=200000
# Inactive chunk versions older than this are prunable (scripts/prune_chunks.py).
INDEX_HISTORY_RETENTION_DAYS=30
