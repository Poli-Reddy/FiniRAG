# ── Database ──
# Render supplies postgres://... ; the app rewrites it to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── LLM: primary ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── LLM: fallback (optional) ──
# Tried when Gemini refuses a call — quota, transport error, or a reply that
# will not parse. Leave GROQ_API_KEY empty to disable the fallback entirely;
# the pipeline then runs on Gemini alone, exactly as it did before.
#
# GROQ_VISION_MODEL must accept image parts AND honour
# response_format=json_object. On the current account only qwen3.8-27b does
# both — qwen3.6-27b fails JSON validation on this workload, and the gpt-oss
# and compound models reject multimodal content outright. No document in the
# dataset has a native text layer, so this is the model that does the work.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── OCR ──
# Mistral is the primary OCR backend (layout blocks for traceable evidence).
# Google Vision remains available as OCR_PROVIDER=google_vision for legacy
# deployments; it needs a service-account JSON. On Render, mount it as a
# secret file and point GOOGLE_VISION_CREDENTIALS at the mount path — a
# repo-relative path will not resolve.
MISTRAL_API_KEY=your_mistral_api_key_here
GOOGLE_VISION_CREDENTIALS=path/to/service_account.json
OCR_PROVIDER=mistral
LLM_PROVIDER=gemini

# ── Application ──
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=10
MAX_PAGES=3
